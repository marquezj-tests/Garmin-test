<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <!--
        ESS Public OPI - a Connect IQ device app that mirrors the public
        operations screen at https://pos.ess.eu/ on the watch.

        type="watch-app" (a "Device App"): the Forerunner 265 family does not
        support the Widget app type, so a device app with a glance view is the
        correct container on this hardware.

        minApiLevel 4.2.0: the oldest level that has GlanceView (3.1.0),
        makeWebRequest (1.3.0) and Application.Storage (2.4.0) while still
        covering every current CIQ 4/5 wearable. The FR265 ships CIQ 5.2.
    -->
    <iq:application id="4c8f1b2a6d3e47a09f5c81b7d2e6a340"
                    type="watch-app"
                    name="@Strings.AppName"
                    entry="EssOpiApp"
                    launcherIcon="@Drawables.LauncherIcon"
                    minApiLevel="4.2.0">
        <iq:products>
            <iq:product id="fr265"/>
            <iq:product id="fr265s"/>
        </iq:products>
        <iq:permissions>
            <iq:uses-permission id="Communications"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
